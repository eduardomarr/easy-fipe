{
  "name": "easy-fipe-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=../.env tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "DOTENV_CONFIG_PATH=../.env vitest run",
    "test:watch": "DOTENV_CONFIG_PATH=../.env vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "DOTENV_CONFIG_PATH=../.env drizzle-kit generate",
    "db:migrate": "DOTENV_CONFIG_PATH=../.env tsx src/db/migrate.ts",
    "db:seed": "DOTENV_CONFIG_PATH=../.env tsx src/db/seed.ts",
    "db:studio": "DOTENV_CONFIG_PATH=../.env drizzle-kit studio"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "express": "^4.21.0",
    "jose": "^5.9.0",
    "postgres": "^3.4.4",
    "resend": "^6.12.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "drizzle-kit": "^0.28.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^2.1.0"
  }
}
