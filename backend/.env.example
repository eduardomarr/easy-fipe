NODE_ENV=development
PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
# Local Postgres via docker-compose (port 54322).
DATABASE_URL=postgres://postgres:postgres@localhost:54322/easy_fipe

# Supabase direct connection — only needed when running migrations against prod.
# Use db.<ref>.supabase.co:5432 (NOT the pooler on port 6543).
# MIGRATIONS_DATABASE_URL=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# "anon / public" key — safe to expose to the browser, but keep out of git.
SUPABASE_ANON_KEY=
# "service_role" key — NEVER expose client-side. Server only.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=

# ── Resend (transactional email) ─────────────────────────────────────────────
# resend.com → API Keys → Create API Key (full access or "Sending access" only)
# Free tier: 3 000 emails/month, 100/day.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Worker ────────────────────────────────────────────────────────────────────
# Random secret ≥ 32 chars. Set the same value in cron-job.org and flyctl secrets.
# Generate: openssl rand -hex 32
WORKER_SECRET=

# ── FIPE API (server-side direct, no proxy) ───────────────────────────────────
FIPE_API_BASE=https://fipe.parallelum.com.br/api/v2
